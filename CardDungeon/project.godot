; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CardDungeon"
run/main_scene="res://scenes/Menu/menu.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")
config/icon="res://Photos/IconLOL.png"

[display]

window/size/resizable=false
window/stretch/mode="viewport"
window/stretch/aspect="ignore"
mouse_cursor/custom_image="res://Photos/hand_and_ring.png"
mouse_cursor/custom_image_hotspot=Vector2(10, 0)
mouse_cursor/tooltip_position_offset=Vector2(0, 0)

[dotnet]

project/assembly_name="Сохранялкагодота"

[file_customization]

folder_colors={
"res://Creatures/": "pink",
"res://Creatures/Enemies/": "red",
"res://Creatures/Enemies/First_loc/": "green",
"res://Creatures/Enemies/First_loc/Boss_Demon/": "red",
"res://Creatures/Enemies/Second_loc/": "yellow",
"res://Creatures/Enemies/Second_loc/FireWorm/": "red",
"res://Creatures/Heroes/": "yellow",
"res://Creatures/Heroes/Archer/": "green",
"res://Creatures/Heroes/Mage/": "purple",
"res://Creatures/Heroes/Warrior/": "red",
"res://Mechanics/": "teal",
"res://Photos/": "purple",
"res://Photos/BackGrounds/Menu/": "teal",
"res://scenes/": "red",
"res://scenes/Battle/": "red",
"res://scenes/ChooseHero/": "blue",
"res://scenes/Cutscene_Elements/": "purple",
"res://scenes/Map/": "orange",
"res://scenes/Menu/": "green"
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="card_target_selector"
2d_physics/layer_2="card_drop_area"

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.211765, 0.239216, 0.290196, 1)
